{
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": ""
    }
  },
  "memory": {
    "interval": 1,
    "rotate": 270,
    "format": "{icon}",
    // "format": " {percentage}%",
    "format-icons": [
      "󰝦",
      "󰪞",
      "󰪟",
      "󰪠",
      "󰪡",
      "󰪢",
      "󰪣",
      "󰪤",
      "󰪥"
    ],
    "max-length": 10
  },
  "cpu": {
    "interval": 1,
    "format": "{icon}",
    "rotate": 270,
    "format-icons": [
      "󰝦",
      "󰪞",
      "󰪟",
      "󰪠",
      "󰪡",
      "󰪢",
      "󰪣",
      "󰪤",
      "󰪥"
    ]
  },
  "tray": {
    "icon-size": 16,
    "rotate": 0,
    "spacing": 3
  },
  "hyprland/window": {
    "format": "<span  weight='bold' >{class}</span>",
    "on-click-right": "pkill waybar & hyprctl dispatch exec waybar",
    "rotate": 90,
    "max-length": 120,
    "icon": false,
    "icon-size": 13
  },
  "clock": {
    "format": "{:%I\n%M\n%S}",
    // "format": "{:%d\n%I\n%M\n%S}", // Dia y hora
    "interval": 1,
    "rotate": 0,
    // "tooltip-format": "<tt>{calendar}</tt>",
    "tooltip-format": "<big>{:%A, %d/%m %H:%M}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    // "calendar": {
    //   "mode": "month",
    //   "mode-mon-col": 3,
    //   "on-scroll": 1,
    //   "on-click-right": "mode",
    //   "format": {
    //     "months": "<span color='#ffead3'><b>{}</b></span>",
    //     "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
    //     "today": "<span color='#ff6699'><b>{}</b></span>"
    //   }
    // },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon}",
    "rotate": 0,
    "format-charging": "<span color='#a6d189'>󱐋</span>",
    "format-plugged": "󰂄",
    "format-icons": [
      "󰝦",
      "󰪞",
      "󰪟",
      "󰪠",
      "󰪡",
      "󰪢",
      "󰪣",
      "󰪤",
      "󰪥"
    ],
    "on-click-right": "pkill waybar & hyprctl dispatch exec waybar"
  },
  "network": {
    "tooltip": true,
    "format-wifi": "{icon} ",
    "format-icons": [
      "󰤟",
      "󰤢",
      "󰤥"
    ],
    "rotate": 0,
    "format-ethernet": "󰈀 ",
    "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "󰈂",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "/usr/local/bin/ags -t ControlPanel",
    "interval": 2
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    //"format": "{volume}%{icon} {format_source}",
    // "format": "{volume}% {icon} ",
    "format": "{icon}",
    "rotate": 0,
    //"format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}%\n{icon}",
    "format-bluetooth-muted": " {icon}",
    "format-muted": " ",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": " ",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ],
    },
    "on-click": "kitty --class wiremix-popup -e wiremix"
  },
}
