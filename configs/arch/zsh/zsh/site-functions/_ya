;;
(exec)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(pkg)
_arguments "${_arguments_options[@]}" : \
":: :_ya__subcmd__help__subcmd__pkg_commands" \
"*::: :->pkg" \
&& ret=0

    case $state in
    (pkg)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
