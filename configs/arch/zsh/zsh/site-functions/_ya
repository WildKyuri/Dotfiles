;;
        esac
    ;;
esac
;;
(pub)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(pub-to)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(sub)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(cache)
_arguments "${_arguments_options[@]}" : \
":: :_ya__subcmd__help__subcmd__cache_commands" \
"*::: :->cache" \
