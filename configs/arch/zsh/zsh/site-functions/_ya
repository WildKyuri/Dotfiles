#compdef ya

autoload -U is-at-least

_ya() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-V[Print version]' \
'--version[Print version]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_ya_commands" \
"*::: :->Ya" \
&& ret=0
    case $state in
    (Ya)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ya-command-$line[1]:"
        case $line[1] in
            (emit)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the action:_default' \
'*::args -- Arguments of the action:_default' \
&& ret=0
;;
(emit-to)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':receiver -- Receiver ID:_default' \
':name -- Name of the action:_default' \
'*::args -- Arguments of the action:_default' \
&& ret=0
;;
(exec)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the action:_default' \
'*::args -- Arguments of the action:_default' \
&& ret=0
;;
(pkg)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_ya__subcmd__pkg_commands" \
"*::: :->pkg" \
&& ret=0

    case $state in
    (pkg)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ya-pkg-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::ids -- Packages to add:_default' \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'--discard[Discard local changes made to packages while deleting]' \
'-h[Print help]' \
'--help[Print help]' \
'*::ids -- Packages to delete:_default' \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
'--discard[Discard local changes made to packages while installing]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
'--discard[Discard local changes made to packages while upgrading]' \
'-h[Print help]' \
'--help[Print help]' \
'*::ids -- Packages to upgrade, upgrade all if unspecified:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_ya__subcmd__pkg__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ya-pkg-help-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(pub)
_arguments "${_arguments_options[@]}" : \
'--str=[Send the message with a string body]:STR:_default' \
'--json=[Send the message with a JSON body]:JSON:_default' \
'*--list=[Send the message as a list of strings]::LIST:_default' \
